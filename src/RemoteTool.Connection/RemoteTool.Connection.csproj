<Project Sdk="Microsoft.NET.Sdk">

  <!--
    連線層：TLS 1.3、主機指紋、帳密、Session Token、三條連線與心跳。
    只用 .NET 標準 API，跨平台，因此可在 Linux 上以真實 TLS 連線測試。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteTool.Connection.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argon2id 密碼雜湊（PLAN §6、PLAN_GAPS G-02）。評估紀錄見 docs/DECISIONS.md D-037 -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteTool.Protocol\RemoteTool.Protocol.csproj" />
  </ItemGroup>

</Project>
