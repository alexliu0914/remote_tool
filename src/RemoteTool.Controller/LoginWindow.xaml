<Window x:Class="RemoteTool.Controller.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteTool 控制端" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=HostBox}">
    <StackPanel Margin="20">
        <TextBlock Text="連線到被控端" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="IP" VerticalAlignment="Center" />
            <TextBox x:Name="HostBox" Grid.Column="1" />
            <TextBlock Text="埠" Grid.Column="2" Margin="10,0,6,0" VerticalAlignment="Center" />
            <TextBox x:Name="PortBox" Grid.Column="3" />

            <TextBlock Text="帳號" Grid.Row="2" VerticalAlignment="Center" />
            <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" />

            <TextBlock Text="密碼" Grid.Row="4" VerticalAlignment="Center" />
            <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" />
        </Grid>

        <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#B00020" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="ForgetButton" Content="移除此主機的指紋記錄" DockPanel.Dock="Left" Click="OnForget" />
            <Button x:Name="ConnectButton" Content="連線" DockPanel.Dock="Right" IsDefault="True" Click="OnConnect" MinWidth="90" />
        </DockPanel>
    </StackPanel>
</Window>
