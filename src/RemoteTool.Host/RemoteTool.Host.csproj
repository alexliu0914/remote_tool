<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host.exe：由 HostGuard 以使用者權限啟動。網路、登入、畫面、剪貼簿、檔案；不呼叫 SendInput。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Host</AssemblyName>
    <RootNamespace>RemoteTool.Host</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteTool.Host.Core\RemoteTool.Host.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Windows\*.cs" Link="Windows\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
