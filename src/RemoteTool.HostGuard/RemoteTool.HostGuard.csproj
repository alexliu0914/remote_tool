<Project Sdk="Microsoft.NET.Sdk">

  <!-- HostGuard.exe：唯一執行 SendInput 的程式。不連網、不讀剪貼簿、不處理畫面或檔案。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>HostGuard</AssemblyName>
    <RootNamespace>RemoteTool.HostGuard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteTool.HostGuard.Core\RemoteTool.HostGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Windows\*.cs" Link="Windows\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
